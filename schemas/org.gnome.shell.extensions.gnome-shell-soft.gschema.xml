<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.gnome-shell-soft" path="/org/gnome/shell/extensions/gnome-shell-soft/">
    <key name="notifications" type="b">
      <default>true</default>
      <summary>Notificações e calendário</summary>
    </key>
    <key name="quick-settings" type="b">
      <default>true</default>
      <summary>Configurações rápidas</summary>
    </key>
    <key name="blur-radius" type="i">
      <default>30</default>
      <range min="1" max="100"/>
      <summary>Intensidade do desfoque em pixels lógicos</summary>
    </key>
    <key name="opacity" type="i">
      <default>55</default>
      <range min="0" max="100"/>
      <summary>Opacidade do fundo em porcentagem</summary>
      <description>Altera somente o fundo; textos, ícones e controles permanecem nítidos.</description>
    </key>
    <key name="brightness" type="i">
      <default>85</default>
      <range min="10" max="100"/>
      <summary>Brilho do desfoque em porcentagem</summary>
    </key>
    <key name="corner-radius" type="i">
      <default>30</default>
      <range min="0" max="100"/>
      <summary>Raio dos cantos em pixels lógicos</summary>
      <description>O recorte do blur requer GNOME Rounded Blur ou suporte nativo a corner-radius.</description>
    </key>
  </schema>
</schemalist>
