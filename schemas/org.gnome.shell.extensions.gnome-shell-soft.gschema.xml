<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.gnome-shell-soft" path="/org/gnome/shell/extensions/gnome-shell-soft/">
    <key name="notifications" type="b">
      <default>true</default>
      <summary>Notificações e calendário</summary>
    </key>
    <key name="quick-settings" type="b">
      <default>true</default>
      <summary>Configurações rápidas</summary>
    </key>
    <key name="system-dialogs" type="b">
      <default>true</default>
      <summary>Diálogos do sistema</summary>
    </key>
    <key name="notification-banners" type="b">
      <default>true</default>
      <summary>Notificações flutuantes</summary>
    </key>
    <key name="app-folders" type="b">
      <default>true</default>
      <summary>Pastas de aplicativos</summary>
    </key>
    <key name="top-panel" type="b">
      <default>true</default>
      <summary>Barra superior</summary>
    </key>
    <key name="window-switcher" type="b">
      <default>true</default>
      <summary>Alternador de janelas</summary>
    </key>
    <key name="osd-windows" type="b">
      <default>false</default>
      <summary>Volume e brilho</summary>
    </key>
    <key name="workspace-switcher" type="b">
      <default>false</default>
      <summary>Troca de área de trabalho</summary>
    </key>
    <key name="screenshot-ui" type="b">
      <default>false</default>
      <summary>Captura de tela</summary>
    </key>
    <key name="popup-menus" type="b">
      <default>false</default>
      <summary>Menus contextuais</summary>
    </key>
    <key name="overview-background" type="b">
      <default>false</default>
      <summary>Overview, grade e pesquisa</summary>
    </key>
    <key name="lock-screen" type="b">
      <default>false</default>
      <summary>Tela de bloqueio</summary>
    </key>
    <key name="panel-enabled-dark" type="b">
      <default>true</default>
      <summary>Blur e transparência da barra superior no tema escuro</summary>
    </key>
    <key name="panel-enabled-light" type="b">
      <default>true</default>
      <summary>Blur e transparência da barra superior no tema claro</summary>
    </key>
    <key name="panel-opaque-dark" type="b">
      <default>false</default>
      <summary>Barra opaca com janela maximizada ou em tela cheia no tema escuro</summary>
    </key>
    <key name="panel-opaque-light" type="b">
      <default>false</default>
      <summary>Barra opaca com janela maximizada ou em tela cheia no tema claro</summary>
    </key>
    <key name="blur-radius" type="i">
      <default>30</default>
      <range min="1" max="100"/>
      <summary>Intensidade do desfoque em pixels lógicos</summary>
    </key>
    <key name="opacity" type="i">
      <default>55</default>
      <range min="0" max="100"/>
      <summary>Opacidade do fundo em porcentagem</summary>
      <description>Altera somente o fundo; textos, ícones e controles permanecem nítidos.</description>
    </key>
    <key name="brightness" type="i">
      <default>85</default>
      <range min="10" max="100"/>
      <summary>Brilho do desfoque em porcentagem</summary>
    </key>
  </schema>
</schemalist>
