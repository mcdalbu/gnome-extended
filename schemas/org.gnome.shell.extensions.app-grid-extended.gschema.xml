<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <!-- Keep the original path so existing preferences survive the rename. -->
  <schema id="org.gnome.shell.extensions.app-grid-extended" path="/org/gnome/shell/extensions/app-grid-soft/">
    <key name="icon-shadow-intensity" type="i">
      <default>24</default>
      <range min="0" max="100"/>
      <summary>Opacidade da sombra dos ícones (%)</summary>
    </key>
    <key name="icon-shadow-offset-x" type="i">
      <default>0</default>
      <range min="-32" max="32"/>
      <summary>Deslocamento horizontal da sombra</summary>
    </key>
    <key name="icon-shadow-offset-y" type="i">
      <default>2</default>
      <range min="-32" max="32"/>
      <summary>Deslocamento vertical da sombra</summary>
    </key>
    <key name="icon-shadow-blur" type="i">
      <default>4</default>
      <range min="0" max="32"/>
      <summary>Desfoque da sombra dos ícones</summary>
    </key>
    <key name="icon-shadow-enabled" type="b">
      <default>true</default>
      <summary>Preferência global antiga, mantida para migração</summary>
    </key>
    <key name="icon-shadow-grid-enabled" type="b">
      <default>true</default>
      <summary>Sombra dos ícones na grade de aplicativos e pastas</summary>
    </key>
    <key name="icon-shadow-dock-enabled" type="b">
      <default>true</default>
      <summary>Sombra dos ícones nos docks detectados</summary>
    </key>
    <key name="icon-shadow-switcher-enabled" type="b">
      <default>true</default>
      <summary>Sombra dos ícones no alternador de aplicativos (Alt+Tab)</summary>
    </key>
  </schema>
</schemalist>
